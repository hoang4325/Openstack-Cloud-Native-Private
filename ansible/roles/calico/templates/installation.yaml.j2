apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Disabled
    nodeAddressAutodetectionV4:
      cidrs:
        - {{ k8s_node_cidr }}
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: {{ k8s_pod_cidr }}
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
