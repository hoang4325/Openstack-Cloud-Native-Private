# Tên cloud OpenStack được khai báo trong clouds.yaml.
cloud_name       = "kolla-admin"
# Region OpenStack sẽ triển khai tài nguyên.
region           = "RegionOne"
# Dải mạng riêng dành cho các node Kubernetes.
tenant_cidr      = "10.20.0.0/24"
# Gateway của subnet Kubernetes.
tenant_gateway   = "10.20.0.1"
# IP cố định của node control plane.
control_fixed_ip = "10.20.0.10"
# IP cố định của node worker.
worker_fixed_ip  = "10.20.0.11"
# Dải mạng được phép truy cập SSH vào node.
ssh_allowed_cidr = "172.30.0.0/24"
