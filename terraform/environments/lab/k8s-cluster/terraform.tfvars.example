# Sao chép thành terraform.tfvars (file này bị .gitignore) rồi chỉnh theo cloud của bạn.
# Mọi biến đều có mặc định khớp lab hiện tại, chỉ cần ghi đè những giá trị khác.
cloud_name = "kolla-admin"
region     = "RegionOne"

# State của environment foundation (backend local).
foundation_state_path = "../foundation/terraform.tfstate"

# Mạng tenant.
tenant_cidr    = "10.20.0.0/24"
tenant_gateway = "10.20.0.1"

# Dải mạng được phép SSH / truy cập NodePort Traefik.
ssh_allowed_cidr     = "172.30.0.0/24"
traefik_allowed_cidr = "172.30.0.1/32"

# Thay cho control_name/control_fixed_ip, worker_name/worker_fixed_ip, monitoring_name/monitoring_fixed_ip
# của phiên bản cũ. Khóa của map là tên máy ảo; thêm worker mới chỉ cần thêm một dòng.
nodes = {
  "k8s-control-01" = {
    role                    = "control"
    flavor                  = "k8s-control"
    fixed_ip                = "10.20.0.10"
    floating_ip_description = "Floating IP for Kubernetes control plane"
  }
  "k8s-worker-01" = {
    role                    = "worker"
    flavor                  = "k8s-small"
    fixed_ip                = "10.20.0.11"
    floating_ip_description = "Floating IP for Kubernetes worker"
  }
  "k8s-monitoring-01" = {
    role                    = "worker"
    flavor                  = "k8s-monitoring-4gb"
    fixed_ip                = "10.20.0.12"
    floating_ip_description = "Floating IP for Kubernetes monitoring worker"
  }
}
