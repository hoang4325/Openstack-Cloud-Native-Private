# Sao chép thành terraform.tfvars (file này bị .gitignore) rồi chỉnh theo cloud của bạn.
# Mọi biến đều có mặc định khớp lab hiện tại, chỉ cần ghi đè những giá trị khác.
cloud_name = "kolla-admin"
region     = "RegionOne"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
keypair_name        = "openstack-lab-key"

external_network_name     = "public-veth"
external_subnet_name      = "public-veth-subnet"
external_physical_network = "physnet1"
external_cidr             = "172.30.0.0/24"
external_gateway          = "172.30.0.1"
floating_ip_start         = "172.30.0.100"
floating_ip_end           = "172.30.0.200"

# Thay cho flavor_name / flavor_ram_mb / flavor_vcpus / flavor_disk_gb của phiên bản cũ.
# Khóa của map là tên flavor trong OpenStack.
flavors = {
  "k8s-small"          = { ram_mb = 2048, vcpus = 2, disk_gb = 20 }
  "k8s-control"        = { ram_mb = 4096, vcpus = 2, disk_gb = 20 }
  "k8s-monitoring"     = { ram_mb = 6144, vcpus = 4, disk_gb = 40 }
  "k8s-monitoring-4gb" = { ram_mb = 4096, vcpus = 4, disk_gb = 40 }
}
